# Rootly environment configuration
#
# Copy to `.env` and restart the dev server. Expo inlines EXPO_PUBLIC_* values
# at BUILD time, so a change here needs `npx expo start --clear` to take effect.
#
# Everything below is optional — the defaults in src/lib/env.ts run the app
# entirely against the in-memory mock server with no backend at all.

# --- Backend -----------------------------------------------------------------

# Serve every request from the mock server instead of the network.
# Set to `false` once you have a real API to point at.
EXPO_PUBLIC_USE_MOCKS=true

# Base URL of the real API. Ignored while USE_MOCKS is true.
EXPO_PUBLIC_API_URL=https://api.rootly.app/v1

# Per-request timeout in milliseconds.
EXPO_PUBLIC_REQUEST_TIMEOUT_MS=15000

# --- Mock tuning (dev only) --------------------------------------------------

# Artificial latency, so loading skeletons are actually visible.
EXPO_PUBLIC_MOCK_LATENCY_MS=450

# Fraction of mock requests that fail, 0–1. Set to 0.5 to exercise every error
# state without touching code. Use `forceMockFailure()` from
# src/api/mock/server.ts for deterministic single failures instead.
EXPO_PUBLIC_MOCK_FAILURE_RATE=0
